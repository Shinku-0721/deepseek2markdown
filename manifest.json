{
  "manifest_version": 3,
  "name": "DeepSeek to Markdown",
  "version": "1.2.1",
  "description": "导出 DeepSeek 聊天记录或分享链接为 Markdown / JSON",
  "permissions": ["activeTab", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://files.deepseeksvc.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DeepSeek to Markdown"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "lib/vendor/fflate.js",
        "lib/markdown-export.js",
        "lib/export-core.js",
        "lib/export-delivery.js",
        "lib/download-client.js",
        "lib/deepseek-client.js",
        "lib/history-cache.js",
        "lib/all-export.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/injected.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ]
}
